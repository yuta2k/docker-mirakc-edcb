Subject: [PATCH] test: simulate an upstream change of ALLOW_SETTING

---
 ini/HttpPublic/legacy/util.lua | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ini/HttpPublic/legacy/util.lua b/ini/HttpPublic/legacy/util.lua
index 549d9b62..5bc1a67b 100644
--- a/ini/HttpPublic/legacy/util.lua
+++ b/ini/HttpPublic/legacy/util.lua
@@ -4,7 +4,7 @@ SHOW_NOTIFY_LOG=true
 SHOW_DEBUG_LOG=false
 
 --設定メニューからの設定の変更を許可するかどうか
-ALLOW_SETTING=false
+ALLOW_SETTING=mg.request_info.remote_addr=='127.0.0.1'
 
 --※true/falseの設定は例えばリモートアドレスと比較して接続元の限定も可能
 --ALLOW_SETTING=mg.request_info.remote_addr=='127.0.0.1' or mg.request_info.remote_addr=='::1'
