+int MirakcConnectBase::openSocket( int domain )
+{
+	pthread_mutex_lock( &lock );
+	if( aborted ) {
+		s = -1;
+		errno = ECANCELED;
+	}
+	else {
+		s = socket( domain, SOCK_STREAM, 0 );
+	}
+	pthread_mutex_unlock( &lock );
+	return s;
+}
+
 void MirakcConnectBase::shutdown()
 {
+	pthread_mutex_lock( &lock );
 	if( s >= 0 ) {
 		::shutdown(s, SHUT_WR);
 	}
+	pthread_mutex_unlock( &lock );
 
 }
 
 void MirakcConnectBase::disconnect()
 {
+	pthread_mutex_lock( &lock );
 	if( s >= 0 ) {
 	
 		::close(s);
 	}
 	s = -1;
+	bufsize = 0;
+	pthread_mutex_unlock( &lock );
+}
+
+void MirakcConnectBase::abort()
+{
+	pthread_mutex_lock( &lock );
+	aborted = true;
+	if( s >= 0 ) {
+		// makes a blocked recv() return 0 and cancels a connect() in progress
+		::shutdown(s, SHUT_RDWR);
+	}
+	pthread_mutex_unlock( &lock );
+}
+
+void MirakcConnectBase::resume()
+{
+	pthread_mutex_lock( &lock );
+	aborted = false;
+	pthread_mutex_unlock( &lock );
+}
+
+bool MirakcConnectBase::isAborted()
+{
+	pthread_mutex_lock( &lock );
+	bool ret = aborted;
+	pthread_mutex_unlock( &lock );
+	return ret;
 }
 
