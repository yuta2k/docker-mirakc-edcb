+// Request the stream of the current channel again after the server closed
+// it or the connection failed: EDCB does not tune again by itself, so the
+// rest of a recording would be lost. Retries until it succeeds or until
+// SetChannel() or CloseTuner() stops the receiving thread (returns FALSE).
+BOOL CBonTuner::Reconnect(void)
+{
+	char szHeader[ 64 ];
+	sprintf(szHeader, "Connection: close\r\nX-Mirakurun-Priority: %d", g_Priority);
+	char respHeader[ 512 ];
+	int respCode;
+	int rc;
+	int waitSec = 1;
+
+	if( conn->isAborted() ) {
+		return FALSE;
+	}
+	ERROR_OUTPUT( "%s: stream closed; reconnecting (%s)", g_TunerName, m_szStreamUrl );
+
+	for( int attempt = 1; ; attempt++ ) {
+		// 1, 2, 4, 5, 5, ... seconds, stopping early when aborted
+		for( int i = 0; i < waitSec * 10; i++ ) {
+			if( conn->isAborted() ) {
+				return FALSE;
+			}
+			usleep( 100 * 1000 );
+		}
+		rc = conn->sendGetRequest_WaitHeader( m_szStreamUrl, szHeader, respHeader, sizeof( respHeader ), &respCode );
+		if( rc == 0 && respCode == 200 ) {
+			ERROR_OUTPUT( "%s: reconnected after %d attempt(s)", g_TunerName, attempt );
+			return TRUE;
+		}
+		conn->disconnect();
+		if( conn->isAborted() ) {
+			return FALSE;
+		}
+		// do not fill the log while the server is down: the first few, then about once a minute
+		if( attempt <= 3 || attempt % 12 == 0 ) {
+			ERROR_OUTPUT( "%s: reconnect failed (attempt:%d, rc:%d, resp:%d)", g_TunerName, attempt, rc, respCode );
+		}
+		waitSec = std::min( waitSec * 2, 5 );
+	}
+}
+
 void CBonTuner::waitForRecvThreadFinish(void)
 {
 	if( m_hRecvThread > 0 ) {
+		conn->abort();
 		pthread_join(m_hRecvThread, NULL); // todo
 		m_hRecvThread = 0;
 	}
+	conn->resume();
 }
 
