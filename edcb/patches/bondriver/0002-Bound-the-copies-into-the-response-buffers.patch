 /*************************************************/
 
+// upper limit of an API response body such as /api/channels
+#define MAX_BODY_SIZE ( 16 * 1024 * 1024 )
+
+// Copy a part of the response header into responceHeader without overflowing it.
+// Returns false if the header does not fit.
+static bool appendResponceHeader( char *responceHeader, size_t responceHeaderSize, size_t *used, const char *data, size_t len )
+{
+	if( *used + len + 1 > responceHeaderSize ) {
+		return false;
+	}
+	::memcpy( responceHeader + *used, data, len );
+	*used += len;
+	responceHeader[ *used ] = 0;
+	return true;
+}
