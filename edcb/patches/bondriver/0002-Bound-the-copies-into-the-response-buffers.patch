+	rc = conn->sendGetRequest_WaitHeader( url, szHeader, respHeader, sizeof( respHeader ), &respCode );
 	if( rc != 0 || respCode != 200 ) {
 		ERROR_OUTPUT( "%s: Tuner unavailable (rc:%d, resp:%d)", g_TunerName, rc, respCode );
 		conn->disconnect();
@@ -580,15 +580,18 @@ BOOL CBonTuner::SendRequest(char *url, char **body, int *bodysize)
 
 		int respCode;
 		char respHeader[ 512 ]; // todo
-		*body = (char *)malloc( 128 * 1024 ); // todo 128k 
 
 		DEBUG_OUTPUT( "request:url:%s", url);
 
 		waitForRecvThreadFinish();
 
-		rc = conn->sendGetRequest_WaitBody( url, szHeader, respHeader, &respCode, *body, bodysize );
+		rc = conn->sendGetRequest_WaitBody( url, szHeader, respHeader, sizeof( respHeader ), &respCode, body, bodysize );
 		if( rc != 0 || respCode != 200 ) {
 			ERROR_OUTPUT( "%s: Tuner unavailable (rc:%d, resp:%d)", g_TunerName, rc, respCode );
+			if( rc == 0 ) {
+				free( *body );
+				*body = NULL;
+			}
 			break;
 		}
 
