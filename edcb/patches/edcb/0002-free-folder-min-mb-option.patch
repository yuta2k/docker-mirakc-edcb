@@ -10,8 +10,8 @@
 class CWriteTSFile
 {
 public:
-	//フォルダに空きがあるとみなす最低容量
-	static const int FREE_FOLDER_MIN_BYTES = 200 * 1024 * 1024;
+	//フォルダに空きがあるとみなす最低容量(既定200MB)を設定する
