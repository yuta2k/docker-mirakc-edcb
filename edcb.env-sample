# edcb.env の見本です。edcb.env にコピーして、必要な行だけ有効にしてください(git 管理外)。
# 書き方は「変数名=値」。値を引用符で囲まないでください(引用符も値に含まれます)。
#
# ここで指定した変数に対応する ini のキーは、コンテナの起動のたびにこの値で上書きされます。
# 指定していない変数のキーは、ini にキーが無いときだけ既定値が書かれます。
# WebUI で変えた設定(既にあるキー)は、指定していない限り変わりません。
#
# 変更内容は起動時のログ(docker compose logs edcb)に出ます。起動せずに確認するには:
#   docker compose exec edcb edcbctl provision --diff

# --- 実行ユーザ ---
# EDCB を動かすユーザとグループ。./edcb/ini と録画先に書き込めるものにする(既定 1000 / 1000)
#PUID=1000
#PGID=1000
# 作成するファイルの umask(例: 002 でグループにも書き込みを許可)
#UMASK=002
# タイムゾーン(既定 Asia/Tokyo)
#TZ=Asia/Tokyo

# --- 接続先(このフェーズでは 1 つだけ) ---
# 既定は同梱の mirakc(mirakc:40772)。外部の mirakc / Mirakurun を使うときに指定する
#MIRAKC_ADDRESS=192.168.0.10
#MIRAKC_PORT=40772

# --- HTTP(WebUI) ---
# EpgTimerSrv.ini [SET] HttpAccessControlList。既定は localhost とプライベートアドレス帯
#EDCB_HTTP_ACL=+127.0.0.1,+192.168.0.0/16
# EpgTimerSrv.ini [SET] HttpPort。値をそのまま書く。
# 既定: ssl_cert.pem があれば 5510,5520,5511s,5521s(s は HTTPS)、無ければ書かない(EDCB の既定 5510)
# 5510 以外のポートは compose.yml では公開していない。compose.override.yml の ports に足す(見本を参照)
#EDCB_HTTP_PORT=5510,5520,5511s,5521s
# EpgTimerSrv.ini [SET] HttpNumThreads(1〜50、既定 50)
#EDCB_HTTP_NUM_THREADS=50

# --- TCP(EpgTimerNW、KonomiTV など) ---
# EpgTimerSrv.ini [SET] EnableTCPSrv(true / false、既定 true)
#EDCB_TCP_ENABLE=true
# EpgTimerSrv.ini [SET] TCPAccessControlList。既定は localhost とプライベートアドレス帯(IPv4)。
# IPv4 と IPv6 の規則を混ぜると、EDCB はすべての接続を拒否する
#EDCB_TCP_ACL=+127.0.0.1,+192.168.0.0/16

# --- そのほか ---
# EpgTimerSrv.ini [SET] CompatFlags(既定 4095。tkntrec 版の EpgTimerNW との互換用)
#EDCB_COMPAT_FLAGS=4095
# 録画保存フォルダ(Common.ini の RecFolderNum / RecFolderPath<N>)。カンマ区切り
#EDCB_REC_FOLDERS=/recorded,/recorded2

# --- WebUI からの設定変更 ---
# Legacy WebUI(/legacy/)からの設定変更を許可するか(true / false、既定 false)。
# 起動のたびにこの値に戻る。起動中に切り替えるには、再起動せずに次を実行する:
#   docker compose exec edcb edcbctl allow-setting on|off|status
#EDCB_LEGACY_ALLOW_SETTING=false
# EMWUI(/E3/)の設定ページから変更を許可する接続元(Setting/HttpPublic.ini [SET] ALLOW_SETTING_LIST)。
# 指定しなければ触らない(EMWUI の既定は 127.0.0.1,::1)
#EDCB_EMWUI_ALLOW_SETTING_LIST=127.0.0.1,::1,192.168.0.10

# --- ログ ---
# EDCB のデバッグログ(EpgTimerSrvDebugLog.txt など)を docker compose logs にも出す(既定 true)
#EDCB_LOG_STDOUT=true
